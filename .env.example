# =================================================================
# 🎯 MPPSC Daily Drill & Evaluator Configuration
# =================================================================
# Fill in your credentials below. This file (.env) is kept private.

# 1. Google Gemini AI API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Open-Source API Key (Get free key from https://console.groq.com/)
# Supports: deepseek-r1-distill-llama-70b, qwen-2.5-32b, mistral-saba-24b, gemma2-9b-it
GROQ_API_KEY=your_groq_api_key_here

# 3. PostgreSQL Connection String (e.g. Neon.tech, Supabase, or ElephantSQL)
# Example: postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=your_postgresql_database_url_here

# 4. Sender Gmail Address (The email sending quizzes and receiving answers)
SENDER_EMAIL=your_sender_email@gmail.com

# 5. Gmail 16-character App Password (Get from https://myaccount.google.com/apppasswords)
# Note: Requires 2-Step Verification enabled on sender Gmail + IMAP enabled in Gmail settings
APP_PASSWORD=your_16_char_app_password

# 6. Receiver Email Address (Your email or student email receiving the quizzes)
RECEIVER_EMAIL=your_receiver_email@gmail.com

# =================================================================
# ⚙️ Topic & Question Customization
# =================================================================
# Specific topics (comma-separated). Example: Indus Valley Civilization (IVC), ICT
# Leave blank to get a general mixed MPPSC Prelims test.
TOPICS=Indus Valley Civilization (IVC), ICT

# Questions per topic (e.g. 15 questions each for IVC and ICT = 30 total questions)
QUESTIONS_PER_TOPIC=15

# Total questions if TOPICS is left blank
TOTAL_QUESTIONS=15

# AI Provider & Models ("gemini" or "groq" - automatically falls back across both!)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=deepseek-r1-distill-llama-70b
